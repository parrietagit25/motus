# Copiar como .env en el servidor (nunca versionar .env).
# Docker Compose pasa estos valores a los contenedores.

# MySQL (contenedor motus_db)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=motus_baes
MYSQL_USER=motus_user
MYSQL_PASSWORD=

# Aplicación
APP_NAME=MOTUS
APP_ENV=production
APP_DEBUG=0
APP_URL=https://motus.example.com
DOMAIN=motus.example.com

# Correo (Resend)
EMAIL_DRIVER=resend
RESEND_API_KEY=
RESEND_BASE_URL=api.resend.com
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
MAIL_REPLY_TO=
MAIL_REPLY_TO_NAME=

# Integraciones
GOOGLE_VISION_API_KEY=
OPENAI_API_KEY=
REALTIME_INTERNAL_BASE_URL=http://127.0.0.1

# Formulario público de financiamiento (opcional: orígenes CORS adicionales, separados por coma)
FINANCIAMIENTO_ORIGENES=
